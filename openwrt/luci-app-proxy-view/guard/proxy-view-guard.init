#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
  mkdir -p /var/run/proxy-view-guard
  chmod 700 /var/run/proxy-view-guard
  procd_open_instance
  procd_set_param command /usr/bin/ruby /usr/share/proxy-view/guard.rb
  procd_set_param respawn 3600 10 3
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param term_timeout 90
  procd_close_instance
}
